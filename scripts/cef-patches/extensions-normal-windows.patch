 std::string BrowserExtensionWindowController::GetWindowTypeText() const {
+#if BUILDFLAG(ENABLE_CEF)
+  // Cra: a page in a CefBrowserView is a popup-type Browser (CEF's way of
+  // dropping the tab strip), but to extensions it is the user's normal browser
+  // window, as in Chrome and Arc. Reporting "popup" made password managers
+  // treat every tab as a sign-in popup opened from the previous one.
+  if (window_type_ == api::tabs::WindowType::kPopup &&
+      browser_->cef_delegate() && browser_->cef_delegate()->IsViewsHosted()) {
+    return api::tabs::ToString(api::tabs::WindowType::kNormal);
+  }
+#endif
   return api::tabs::ToString(window_type_);
 }
 
