@@ -57,6 +57,10 @@
 #include "chrome/browser/ui/window_feature_controller/window_feature_controller.h"
 #endif  // !BUILDFLAG(IS_ANDROID)
 
+#if BUILDFLAG(ENABLE_CEF)
+#include "cef/libcef/browser/chrome/browser_delegate.h"
+#endif
+
 using content::WebContents;
 using extensions::browser_window_util::GetLastActiveBrowserWithProfile;
 
@@ -145,9 +149,18 @@ bool OpenPopupInBrowser(BrowserWindowInterface& browser,
   // exists, so the check below is sufficient.
   // On other platforms, ExtensionsContainer is always constructed except for
   // guest sessions, so we need more detailed checks.
-  if (!WindowFeatureController::From(&browser)->SupportsWindowFeature(
-          WindowFeatureController::WindowFeature::kFeatureToolbar) ||
-      !BrowserWindow::FromBrowser(&browser)->IsToolbarVisible()) {
+  bool has_toolbar =
+      WindowFeatureController::From(&browser)->SupportsWindowFeature(
+          WindowFeatureController::WindowFeature::kFeatureToolbar) &&
+      BrowserWindow::FromBrowser(&browser)->IsToolbarVisible();
+#if BUILDFLAG(ENABLE_CEF)
+  // Cra: CEF hosts pages in popup-type Browsers, which never "have" a toolbar,
+  // and Cra draws its own toolbar over Chrome's hidden one. The extensions
+  // container still shows the popup, as it does for Cra's toolbar buttons.
+  has_toolbar = has_toolbar ||
+                (browser.cef_delegate() && browser.cef_delegate()->IsViewsHosted());
+#endif
+  if (!has_toolbar) {
     *error = "Browser window has no toolbar.";
     return false;
   }
